# Copy to .env.local and fill in. Only NEXT_PUBLIC_* values reach the browser.

# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never NEXT_PUBLIC_

# Canonical origin used in links and installers
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Daily cleanup cron (/api/cron/cleanup) sends this as a bearer token
CRON_SECRET=change-me

# Optional
# NEXT_PUBLIC_REMOTION_LICENSE_KEY=   # required by Remotion for companies above its free tier
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_HINGLISH_DISABLED=1     # hide the Hindi / Hinglish speech model
# GUEST_STALE_DAYS=7
# STORAGE_FILE_DAYS=7
# COMPANIONS_ENABLED=1                # allow the optional desktop helper to pair
